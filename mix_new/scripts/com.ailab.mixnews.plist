<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ежедневный автозапуск парсера в 9:00. Шаблон: scripts/autorun.sh install
     подставляет вместо __PROJECT_DIR__ путь к папке проекта на этом компьютере. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ailab.mixnews</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/run.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/autorun.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/autorun.log</string>
</dict>
</plist>
